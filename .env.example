RUST_LOG=info
IDRISI_API_BIND=0.0.0.0:8080
DATABASE_URL=postgres://idrisi:idrisi_dev_only_change_me@localhost:5432/idrisi
POSTGRES_DB=idrisi
POSTGRES_USER=idrisi
POSTGRES_PASSWORD=idrisi_dev_only_change_me
POSTGRES_PORT=5432
IDRISI_API_PORT=8080
MARTIN_DB_PASSWORD=martin_dev_only_change_me
IDRISI_INGEST_DB_PASSWORD=ingest_dev_only_change_me
IDRISI_PUBLISH_DB_PASSWORD=publish_dev_only_change_me
MAP_VIEWER_PORT=8090
# Ingestion worker
IDRISI_WORKER_ALLOWED_HOSTS=download.geofabrik.de
IDRISI_WORKER_MAX_SOURCE_BYTES=21474836480
IDRISI_WORKER_POLL_SECONDS=5
IDRISI_WORKER_LEASE_SECONDS=300
IDRISI_WORKER_HEARTBEAT_SECONDS=30
IDRISI_WORKER_REQUEST_TIMEOUT_SECONDS=14400
IDRISI_OSMIUM_PATH=/usr/bin/osmium
IDRISI_WORKER_INSPECTION_TIMEOUT_SECONDS=1800
IDRISI_OSM2PGSQL_PATH=/usr/bin/osm2pgsql
IDRISI_WORKER_IMPORT_TIMEOUT_SECONDS=21600
IDRISI_OSM_STYLE_PATH=/opt/idrisi/osm2pgsql/bandung.lua

# Dataset publisher (separate DB identity from ingestion)
IDRISI_PUBLISHER_POLL_SECONDS=5
IDRISI_PUBLISHER_LEASE_SECONDS=300
IDRISI_PUBLISHER_HEARTBEAT_SECONDS=30
